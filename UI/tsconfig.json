{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": [],
    "outDir": "./Build",
    "noEmit": true,
    "paths": {
      "@/*": ["./Src/*"],
      "@Shared/*": ["../Shared/*"]
    }
  },
  "include": ["./Src/**/*.ts", "./Src/**/*.tsx", "./Src/**/*.vue", "./vite.config.ts"]
}
