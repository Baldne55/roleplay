{
  "name": "roleplay",
  "version": "0.1.0",
  "private": true,
  "description": "Text-roleplay FiveM server (Backend + Frontend + UI + UCP).",
  "workspaces": [
    "Shared",
    "Backend",
    "Frontend",
    "UI",
    "LoadScreen",
    "UCP/Backend",
    "UCP/Frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
